{
  "manifest_version": 3,
  "name": "HypeBlock — spoiler & hype blocker",
  "short_name": "HypeBlock",
  "version": "1.1.0",
  "description": "Blurs game spoilers and mutes hype (GTA 6 and friends) on X, YouTube, Reddit, Google and any site you choose. Runs locally, collects nothing.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "HypeBlock",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://*.youtube.com/*",
    "https://*.reddit.com/*",
    "https://www.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://*.youtube.com/*",
        "https://*.reddit.com/*",
        "https://www.google.com/*"
      ],
      "js": [
        "src/filters.js",
        "src/adapters.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "hypeblock@coolerwave",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "scripts": [
      "src/background.js"
    ]
  }
}
